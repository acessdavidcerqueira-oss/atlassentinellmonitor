# Atlas Sentinel usa Supabase Auth e Supabase Database para persistência real.
# Copie este arquivo para .env.local e preencha as duas variáveis abaixo.

NEXT_PUBLIC_APP_NAME="ATLAS SENTINEL"
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Somente para scripts administrativos locais. Nunca use no frontend.
SUPABASE_SERVICE_ROLE_KEY=""
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_URL=""
GENERIC_SEARCH_API_KEY=""
BRAND24_API_KEY=""
MAX_UPLOAD_MB=25
RATE_LIMIT_REQUESTS_PER_MINUTE=120
